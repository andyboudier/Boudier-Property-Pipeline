# ─── Firebase Admin (server-side) ────────────────────────────────────────────
# Create a service account in Firebase Console → Project Settings → Service Accounts
# → Generate new private key. Paste values below. On Vercel, add these as
# Environment Variables (Production + Preview).
#
# The whole service-account JSON, single line, OR the three discrete vars below.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Keep the literal \n escapes — they are converted at runtime.
FIREBASE_PRIVATE_KEY=""

# Optional: a single shared password to gate the app (very light auth).
# Leave blank to disable the gate.
APP_ACCESS_PASSWORD=

# ── Unbroken Freehold Finder ────────────────────────────────────────────────
# Google Maps JavaScript API. This key reaches the browser by necessity — lock
# it down with HTTP-referrer and API restrictions in Google Cloud, not secrecy.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Supabase Postgres + PostGIS — the land-data store (Firestore keeps the deals).
# The service key is server-side only; never expose it to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ETL only (not needed by the app). See etl/README.md.
EPC_API_KEY=
COMPANIES_HOUSE_API_KEY=
# Licence gates — set to 1 only once Andy has accepted each dataset's terms.
INSPIRE_LICENCE_ACCEPTED=
OS_LICENCE_ACCEPTED=
HMLR_LICENCE_ACCEPTED=
EPC_LICENCE_ACCEPTED=
VOA_LICENCE_ACCEPTED=
